{
  "openapi": "3.1.0",
  "info": {
    "title": "Infinite Flight Tracker Live API",
    "version": "2.1.0",
    "description": "Read-only live Infinite Flight aircraft lookup. The GPT supplies an aircraft or callsign such as DHL122. The backend searches currently available Infinite Flight servers."
  },
  "servers": [
    {
      "url": "https://vbifkgzmczbndtawawre.supabase.co/functions/v1/flights"
    }
  ],
  "paths": {
    "/lookup": {
      "get": {
        "operationId": "lookupAircraft",
        "summary": "Look up one live Infinite Flight aircraft",
        "description": "Use this endpoint when the user gives an Infinite Flight callsign or aircraft search term. Example: DHL122. If the server is omitted, all currently available servers are searched.",
        "parameters": [
          {
            "name": "aircraft",
            "in": "query",
            "required": true,
            "description": "Aircraft callsign or search text, for example DHL122.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "server",
            "in": "query",
            "required": false,
            "description": "Optional Infinite Flight server. Omit to search all available servers.",
            "schema": {
              "type": "string",
              "enum": [
                "casual",
                "training",
                "expert"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact live aircraft lookup result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "query",
                    "count",
                    "matches"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "matches": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "callsign": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "pilot": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "aircraft_type": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "livery_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "origin": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "destination": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "latitude": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "longitude": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "altitude_ft": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "speed_kt": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "heading_deg": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "vertical_speed_fpm": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "server": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing aircraft name"
          },
          "502": {
            "description": "Infinite Flight Live API error"
          }
        }
      }
    }
  }
}
